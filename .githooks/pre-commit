#!/usr/bin/env sh
# Velenza Inarch Pre-Commit Open-Source Hygiene Guard
#
# Blocks commits that:
# 1. Stage local runtime files (`inarch.toml` or `.inarch/*`)
# 2. Match any organization-specific pattern in `.git/info/forbidden-patterns.txt`
# 3. Fail `cargo test --test open_source_hygiene_test` (which checks cryptographic
#    token digests, workstation path prefixes, and private/Tailscale IPv4 literals).

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# 1. Block staging of local configuration or storage directories
if git diff --cached --name-only | grep -E '^(inarch\.toml|\.inarch/)' >/dev/null 2>&1; then
    echo "ERROR: Refusing to commit local 'inarch.toml' or '.inarch/' directory." >&2
    exit 1
fi

# 2. Scan staged files against .git/info/forbidden-patterns.txt if present
PATTERNS_FILE="$REPO_ROOT/.git/info/forbidden-patterns.txt"
if [ -f "$PATTERNS_FILE" ]; then
    STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR)"
    if [ -n "$STAGED_FILES" ]; then
        while IFS= read -r pattern || [ -n "$pattern" ]; do
            clean_pat="$(printf '%s' "$pattern" | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
            if [ -z "$clean_pat" ] || [ "${clean_pat#\#}" != "$clean_pat" ]; then
                continue
            fi
            for f in $STAGED_FILES; do
                if [ -f "$f" ] && grep -i -F "$clean_pat" "$f" >/dev/null 2>&1; then
                    echo "ERROR: Open-source hygiene violation in '$f' (matched forbidden pattern in .git/info/forbidden-patterns.txt)." >&2
                    exit 1
                fi
            done
        done < "$PATTERNS_FILE"
    fi
fi

# 3. Run the open-source hygiene & config contract check.
# On macOS developer workstations, local cargo builds/tests may be offloaded to remote Linux workers,
# so we run an equivalent zero-compile staged-file hygiene scan unless VELENZA_PRECOMMIT_CARGO=1.
if [ "$(uname -s)" = "Darwin" ] && [ "${VELENZA_PRECOMMIT_CARGO:-0}" != "1" ]; then
    python3 - "$REPO_ROOT" <<'PY'
import re, subprocess, sys

repo_root = sys.argv[1]
out = subprocess.check_output(
    ["git", "-C", repo_root, "diff", "--cached", "--name-only", "--diff-filter=ACMR"],
    text=True,
)
workstation_re = re.compile(r"(/Users/[A-Za-z0-9][A-Za-z0-9._-]*|/Volumes/[A-Za-z0-9][A-Za-z0-9._-]*|/home/[A-Za-z0-9][A-Za-z0-9._-]*|C:[/\\]Users[/\\][A-Za-z0-9][A-Za-z0-9._-]*)")
private_ip_re = re.compile(r"\b(100\.\d{1,3}\.\d{1,3}\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3})\b")

for rel in [line.strip() for line in out.splitlines() if line.strip()]:
    if rel.endswith("open_source_hygiene_test.rs") or rel == ".githooks/pre-commit":
        continue
    try:
        with open(f"{repo_root}/{rel}", "r", encoding="utf-8", errors="ignore") as fh:
            text = fh.read()
    except OSError:
        continue
    m_ws = workstation_re.search(text)
    if m_ws:
        print(f"ERROR: Hardcoded workstation path '{m_ws.group(0)}' in staged file '{rel}'.", file=sys.stderr)
        sys.exit(1)
    m_ip = private_ip_re.search(text)
    if m_ip:
        print(f"ERROR: Private/Tailscale IPv4 literal '{m_ip.group(0)}' in staged file '{rel}'.", file=sys.stderr)
        sys.exit(1)
PY
elif command -v cargo >/dev/null 2>&1; then
    cargo test --test open_source_hygiene_test --quiet
elif [ -x "$HOME/.cargo/bin/cargo" ]; then
    "$HOME/.cargo/bin/cargo" test --test open_source_hygiene_test --quiet
fi

