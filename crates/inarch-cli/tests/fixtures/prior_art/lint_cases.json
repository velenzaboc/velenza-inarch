    {"name": "sources-exactly-six-cover-all-four-accepted", "group": "sources", "expect_ok": true, "ops": [{"op": "keep_first", "count": 6}]},
    {"name": "sources-name-case-is-ignored", "group": "sources", "expect_ok": true, "ops": [{"op": "set_row", "index": 0, "field": "source", "value": "ARXIV"}, {"op": "set_row", "index": 3, "field": "source", "value": "patents"}]},

    {"name": "dates-blank-date", "group": "dates", "ops": [{"op": "set_row", "index": 0, "field": "date", "value": ""}], "expect": [{"kind": "MissingDate"}]},
    {"name": "dates-feb-30", "group": "dates", "ops": [{"op": "set_row", "index": 1, "field": "date", "value": "2026-02-30"}], "expect": [{"kind": "MissingDate"}]},
    {"name": "dates-day-first", "group": "dates", "ops": [{"op": "set_row", "index": 2, "field": "date", "value": "22/10/2026"}], "expect": [{"kind": "MissingDate"}]},
    {"name": "dates-month-13", "group": "dates", "ops": [{"op": "set_row", "index": 3, "field": "date", "value": "2026-13-01"}], "expect": [{"kind": "MissingDate"}]},
    {"name": "dates-feb-29-in-a-common-year", "group": "dates", "ops": [{"op": "set_row", "index": 4, "field": "date", "value": "2026-02-29"}], "expect": [{"kind": "MissingDate"}]},
    {"name": "dates-undated-row-is-not-counted", "group": "dates", "ops": [{"op": "keep_first", "count": 6}, {"op": "set_row", "index": 5, "field": "date", "value": ""}], "expect": [{"kind": "MissingDate"}, {"kind": "TooFewQueries", "found": 5}]},
    {"name": "dates-leap-day-accepted", "group": "dates", "expect_ok": true, "ops": [{"op": "set_row", "index": 0, "field": "date", "value": "2028-02-29"}]},
    {"name": "dates-never-compared-with-the-clock", "group": "dates", "expect_ok": true, "ops": [{"op": "set_row", "index": 0, "field": "date", "value": "2999-01-01"}]},

    {"name": "rows-blank-query-text", "group": "rows", "ops": [{"op": "set_row", "index": 0, "field": "query", "value": ""}], "expect": [{"kind": "MissingQueryText"}]},
    {"name": "rows-spaces-only-query-text", "group": "rows", "ops": [{"op": "set_row", "index": 2, "field": "query", "value": "   "}], "expect": [{"kind": "MissingQueryText"}]},
    {"name": "rows-blank-query-row-is-not-counted", "group": "rows", "ops": [{"op": "keep_first", "count": 6}, {"op": "set_row", "index": 2, "field": "query", "value": ""}], "expect": [{"kind": "MissingQueryText"}, {"kind": "TooFewQueries", "found": 5}]},
    {"name": "rows-three-cells", "group": "rows", "render": ["raw_row:| 2026-10-22 | arXiv | a row with only three cells |"], "expect": [{"kind": "MalformedRow"}]},
    {"name": "rows-five-cells", "group": "rows", "render": ["raw_row:| 2026-10-22 | arXiv | a row with five cells | fixture result | extra |"], "expect": [{"kind": "MalformedRow"}]},
    {"name": "rows-result-text-is-free", "group": "rows", "expect_ok": true, "ops": [{"op": "set_row", "index": 0, "field": "result", "value": ""}]},

    {"name": "structure-no-table", "group": "structure", "render": ["no_table"], "expect": [{"kind": "MalformedTable"}]},
    {"name": "structure-no-table-crlf", "group": "structure", "render": ["no_table", "crlf"], "expect": [{"kind": "MalformedTable"}]},
    {"name": "structure-header-names-differ", "group": "structure", "render": ["bad_header"], "expect": [{"kind": "MalformedTable"}]},
