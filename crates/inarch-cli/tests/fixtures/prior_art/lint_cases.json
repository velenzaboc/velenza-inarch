    {"name": "structure-crlf-line-endings-accepted", "group": "structure", "expect_ok": true, "render": ["crlf"]},
    {"name": "structure-row-order-is-ignored", "group": "structure", "expect_ok": true, "render": ["reverse"]},
    {"name": "structure-other-tables-are-ignored", "group": "structure", "expect_ok": true, "render": ["decoy"]},
