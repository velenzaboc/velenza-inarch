{
  "format": 1,
  "description": "Golden changeset descriptions for the changeset v2 contract suite. These are inputs, not encodings: the suite builds a changeset from each description, encodes it, decodes it, re-encodes it and compares bytes and ids. Hash-valued fields are given as seed strings that the suite hashes. A vector may later gain expected_canonical_hex and expected_id_hex members, which freeze its encoding as a regression fixture once an encoder has produced it.",
  "grammar": {
    "base": "{log_position: u64} or {proven_publication: seed}",
    "class": "pre_land or pre_proven",
    "delta": "list of {path, tracked:{content,file_type}} or {path, deleted:true} or {path, operator:{class,added,removed}}",
    "writes": "{paths:[..], symbols:[{symbol, interface, body}]}",
    "reads": "{policy_version?, point:[{interface:{symbol,hash}} or {decision:{id,version}}], predicate:[{symbol,dep_version}], behavior:[{target,closure}]}",
    "deps_resolves": "lists of seeds that the suite turns into changeset ids",
    "hints": "list of {kind, digest}",
    "head": "log end used when the submission form is decoded; never smaller than a log_position base"
  },
